test_dat <- iris
iris
iris$Species
summary(iris)
condition <- rep(c(wet, dry), 25)
condition <- rep(c('wet', 'dry'), 25)
condition
condition <- rep(c('wet', 'dry'), 25*3)
test_dat$condition <- condition
test_dat$condition <- as.factor(test_dat$condition)
summary(test_dat)
data <- test_dat
library(UNKstats)
run_twoway(data, dv = Sepal.Length, factor_a = Species, factor_b = condition, include_interaction = F, which_factor = Species)
run_twoway(data, dv = 'Sepal.Length', factor_a = 'Species', factor_b = 'condition', include_interaction = F, which_factor = Species)
run_twoway(data, dv = 'Sepal.Length', factor_a = 'Species', factor_b = 'condition', include_interaction = F, which_factor = 'Species')
library(tidyverse)
run_twoway(data, dv = 'Sepal.Length', factor_a = 'Species', factor_b = 'condition', include_interaction = F, which_factor = 'Species')
